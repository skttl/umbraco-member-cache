<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>17.0.0</Version>
    <PackageId>Umbraco.Community.MemberCache</PackageId>
    <Authors>skttl</Authors>
    <Description>Published member caching with ModelsBuilder support, automatic Member Picker conversion and distributed invalidation for Umbraco.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageProjectUrl>https://github.com/skttl/umbraco-member-cache</PackageProjectUrl>
    <RepositoryUrl>https://github.com/skttl/umbraco-member-cache</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>umbraco;umbraco-marketplace;members;cache;ModelsBuilder</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Umbraco.Cms.Core" Version="[17.0.0,18.0.0)" />
    <PackageReference Include="Microsoft.Extensions.Caching.Hybrid" Version="10.0.0" />
    <InternalsVisibleTo Include="Umbraco.Community.MemberCache.Tests" />
    <None Include="../../icon.png" Pack="true" PackagePath="/" />
    <None Include="../../docs/nuget-readme.md" Pack="true" PackagePath="/README.md" />
    <None Update="appsettings-schema.Umbraco.Community.MemberCache.json" Pack="true" PackagePath="/" />
    <None Update="buildTransitive/Umbraco.Community.MemberCache.targets" Pack="true" PackagePath="buildTransitive/Umbraco.Community.MemberCache.targets" />
  </ItemGroup>

</Project>
