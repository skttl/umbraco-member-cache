{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Umbraco Community Member Cache",
  "type": "object",
  "properties": {
    "Umbraco": {
      "type": "object",
      "properties": {
        "Community": {
          "type": "object",
          "properties": {
            "MemberCache": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "MaxModels": {
                  "type": "integer", "minimum": 1, "default": 10000,
                  "description": "Maximum published member models retained per server. This counts models, not bytes."
                },
                "LocalCacheExpiration": {
                  "type": "string", "default": "1.00:00:00",
                  "description": "Positive .NET TimeSpan for local snapshots and published models."
                },
                "CacheExpiration": {
                  "type": "string", "default": "365.00:00:00",
                  "description": "Positive .NET TimeSpan for snapshots in distributed cache."
                },
                "Seed": {
                  "type": "object", "additionalProperties": false,
                  "properties": {
                    "Enabled": { "type": "boolean", "default": false, "description": "Warm snapshots before startup completes. Provider errors fail startup." },
                    "MemberTypes": { "type": "array", "default": [], "items": { "type": "string", "minLength": 1 }, "description": "Member type aliases selected for seeding." },
                    "BatchSize": { "type": "integer", "minimum": 1, "default": 100 }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
